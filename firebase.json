{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8081 },
    "functions": { "port": 5001 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      // `public` is the whole repo root (simplest layout for a static
      // site with no build step) - so everything that isn't a page the
      // browser actually loads must be explicitly blocked here, or it
      // gets served as a plain file straight off the live domain. This
      // list was added after finding functions/**, scripts/**, and the
      // *.md docs were all directly fetchable from freshsnacksja.com.
      "functions/**",
      "scripts/**",
      "*.md",
      "package.json",
      "package-lock.json",
      "firestore.rules",
      "firestore.indexes.json",
      "storage.rules",
      "firebase-seed.json",
      "data.json",
      "fresh-snacks-poster-html/**"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      }
    ]
  }
}
